    "scope": { "x": 4720, "y": 2280, "w": 560, "text": "Base product only: one question (the goal), no study plan, no quiz, no exam marks, no feedback loop. Those arrive as expansions and get their own page here once the base is settled.", "size": "l", "fill": "blue", "page": "base" },

    "cards-title": { "x": 0, "y": -300, "text": "Card designs you kept, next to Structure and Lamp", "kind": "title1", "maxW": 4960, "page": "cards" },
    "cards-how": { "x": 0, "y": 2240, "w": 560, "text": "Each frame is one picture of a design, so it cannot be edited here. Every design uses the same cards and the same fields: choosing one changes only the look. Structure and Lamp, the two you already like, are in the settings frames.", "size": "l", "fill": "blue", "page": "cards" },
    "v2-map": { "x": 0, "y": -300, "text": "The map: track, lecture mind map, themes", "kind": "title1", "maxW": 4640, "page": "v2" },
    "v2-flow": { "x": 0, "y": 840, "text": "From files to Anki", "kind": "title1", "maxW": 5820, "page": "v2" },
    "v2-rest": { "x": 0, "y": 1980, "text": "Settings, card look, copy for chat", "kind": "title1", "maxW": 3460, "page": "v2" },
    "v2-how": { "x": 4720, "y": 0, "w": 560, "text": "Direction v2 combines your picks: the native look with lecture colours and the winding track, a full-width map, a slim bar with the next action, and one side panel for all details that opens on demand.", "size": "l", "fill": "blue", "page": "v2" },
    "alt-lang": { "x": 0, "y": -1440, "text": "Design language: the same result screen in four new looks", "kind": "title1", "maxW": 9960, "page": "alt" },
    "alt-lang-a": { "x": 10040, "y": -1140, "w": 560, "text": "Language A is the current look, \"Survey sheet\". It is not repeated here: the three \"Map, whole course\" frames two rows down show the same screen in it.", "size": "l", "fill": "gray", "page": "alt" },
    "alt-layout": { "x": 0, "y": -300, "text": "Layout: one frame before and after generation", "kind": "title1", "maxW": 4360, "page": "alt" },
    "alt-map": { "x": 0, "y": 680, "text": "Map style: zoom from the course into a lecture", "kind": "title1", "maxW": 7400, "page": "alt" },
    "alt-files": { "x": 0, "y": 1820, "text": "After upload: what to show about the files", "kind": "title1", "maxW": 3460, "page": "alt" },
    "alt-run": { "x": 0, "y": 2960, "text": "The run: three frames each, start, midway, done", "kind": "title1", "maxW": 5680, "page": "alt" },
    "alt-settings": { "x": 0, "y": 3940, "text": "Settings", "kind": "title1", "maxW": 3460, "page": "alt" },
