#!/bin/sh
# Pre-commit: check exactly what is staged, fast, with one-command fixes.
# Installed by `pnpm install` (the `prepare` script points core.hooksPath here).
# Typecheck and tests run in CI and in `pnpm check`, not here.

set -e

staged() {
  git diff --cached --name-only --diff-filter=ACMR | grep -E "$1" || true
}

files=$(staged '^packages/.*\.(ts|tsx|mjs|js|css|json|md)$')
if [ -n "$files" ]; then
  echo "$files" | tr '\n' '\0' | xargs -0 pnpm exec prettier --check --ignore-unknown ||
    { echo 'pre-commit: formatting is off. Run `pnpm format` and stage again.' >&2; exit 1; }
fi

code=$(staged '^packages/.*\.(ts|tsx|mjs)$')
if [ -n "$code" ]; then
  echo "$code" | tr '\n' '\0' | xargs -0 pnpm exec eslint --max-warnings 0 ||
    { echo 'pre-commit: eslint found problems (some are fixable with `pnpm lint --fix`).' >&2; exit 1; }
fi
