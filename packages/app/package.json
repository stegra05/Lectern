{
  "name": "@lectern/app",
  "private": true,
  "version": "3.0.0",
  "description": "Lectern v3 desktop app: the Electron shell around @lectern/engine",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "shots": "electron-vite build && LECTERN_SHOTS=out/shots playwright test shots"
  },
  "dependencies": {
    "@lectern/engine": "workspace:*",
    "@napi-rs/canvas": "^1.0.2",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "45.3.1",
    "electron-vite": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.0",
    "zustand": "^5.0.14"
  }
}
